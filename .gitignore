__pycache__/
*.pyc
.DS_Store
.venv/
venv/
# data lives one level up, never vendored
BundleRec/
bundlemllm/
dunnhumby/
# large / regenerated artifacts
*.pt
*.npy
results/*.json
results/*.csv
!results/.gitkeep
# canonical regenerated tables are version-controlled on purpose
!results/matrix_zeroparam.csv
!results/matrix_zeroparam.json
!results/matrix_zeroparam.meta.json
# measured weight-sensitivity sweeps that back fig_wsweep (make_figs.py reads these)
!results/wsweep_pog.json
!results/wsweep_spotify.json
# Phase-2 matched-protocol baseline results
!results/baselines_*.json
# worked case study backing notes/methodology.tex
!results/case_study_*.json

# derived feature caches
*.npz

# LaTeX build artifacts (keep main.pdf)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
# LaTeX build artifacts in notes (keep .tex and .pdf)
notes/*.aux
notes/*.log
notes/*.out
notes/*.toc

# Local end-to-end smoke run; full verified refresh is retained.
results/runner_smoke/
results/mechanism_smoke*/
results/**/.runner.lock
checkpoints/
reports/

# Isolated novelty-attribution smoke outputs are not benchmark evidence.
results/novelty_smoke*/
results/amplified_fallback_smoke*/
results/sufficiency_smoke*/

# Per-query predictions are large (about 600 MB) and stay on disk; summaries and reports are tracked.
results/sufficiency/*/queries/
results/novelty_attribution/*/queries/
results/amplified_fallback/*/queries/
